Ontology(<http://swot.sisinflab.poliba.it/home>

Declaration(Class(:Air_conditioner))
Declaration(Class(:Appliance))
Declaration(Class(:Boolean_sensor))
Declaration(Class(:Brightness_sensor))
Declaration(Class(:Categorical_sensor))
